{
  "headers": [
    {
      "// note": "Everything under /_expo/static is content-hashed by the export, so a change ships a new filename. Vercel's default (max-age=0, must-revalidate) makes the browser revalidate the whole JS bundle on every visit; immutable lets it be reused outright.",
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "// note": "The service worker must never be served stale, or clients can be pinned to an old cache policy indefinitely.",
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/network/:path+",
      "destination": "/mcn/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
