# Copy to .env and fill in. .env is gitignored — never commit real values.
# Which environment you point at is decided entirely by these values.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings -> API. Use the PREPROD project for local development.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Google OAuth ────────────────────────────────────────────────────────────
# Google Cloud Console -> Credentials. One client per environment.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── Cloudinary (unsigned upload) ────────────────────────────────────────────
# Same cloud for both environments; use a preprod-scoped preset locally.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Site origin ─────────────────────────────────────────────────────────────
# Used for share links and the native admin redirect. On web the app reads
# window.location.origin instead, so this only matters for native builds.
#   local    http://localhost:8081
#   preprod  https://staging.<your-domain>
#   prod     https://<your-domain>
EXPO_PUBLIC_SITE_URL=http://localhost:8081

# ── MSG91 Phone OTP Widget ──────────────────────────────────────────────────
# Widget ID and client Token from MSG91 dashboard (OTP section).
# Note: Server-side secret MSG91_AUTHKEY must be set in Supabase Edge Functions:
#   npx supabase secrets set MSG91_AUTHKEY=<authkey>
EXPO_PUBLIC_MSG91_WIDGET_ID=SecureOTPWidgetYXQ4
EXPO_PUBLIC_MSG91_TOKEN_AUTH=558696A2ZGmzl7Cb6a8154b3P1
# ── Web Push (VAPID) ────────────────────────────────────────────────────────
# Public VAPID key shipped to the browser bundle for Web Push subscriptions.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
